<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;win-x64</RuntimeIdentifiers>
    <AssemblyName>XNAFormatter</AssemblyName>
    <RootNamespace>XNAFormatter</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Eto.Forms" Version="2.13.0" />
    <PackageReference Include="Eto.Platform.Mac64" Version="2.13.0" />
    <PackageReference Include="Eto.Platform.Gtk" Version="2.13.0" />
    <PackageReference Include="Eto.Platform.Wpf" Version="2.13.0" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FormatterForm.cs" />
    <Compile Include="../../Tools/Shared/ToolPaths.cs" Link="ToolPaths.cs" />
    <Compile Include="../../Tools/Shared/ToolApp.cs" Link="ToolApp.cs" />
  </ItemGroup>
</Project>
